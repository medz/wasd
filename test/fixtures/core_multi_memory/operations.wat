(module
  (import "host" "tick" (func $tick))
  (import "host" "left" (memory $left 1 2))
  (import "host" "right" (memory $right 1 3))
  (memory $local 1 2)
  (export "left" (memory $left)) (export "right" (memory $right))
  (export "rightAlias" (memory $right)) (export "local" (memory $local))
  (data (memory $right) (i32.const 2) "\11\22\33\44")
  (data $passive "\ab\cd")
  (func (export "load") (param i32) (result i32)
    call $tick (i32.load $right (local.get 0)))
  (func (export "store") (param i32 i32)
    call $tick (i32.store $right (local.get 0) (local.get 1)))
  (func (export "copy") (param i32 i32 i32)
    call $tick (memory.copy $local $right (local.get 0) (local.get 1) (local.get 2)))
  (func (export "fill") (param i32 i32 i32)
    call $tick (memory.fill $right (local.get 0) (local.get 1) (local.get 2)))
  (func (export "init") (param i32 i32 i32)
    call $tick (memory.init $local $passive (local.get 0) (local.get 1) (local.get 2)))
  (func (export "drop") call $tick data.drop $passive)
  (func (export "size") (result i32) call $tick memory.size $right)
  (func (export "grow") (param i32) (result i32)
    call $tick (memory.grow $right (local.get 0)))
)