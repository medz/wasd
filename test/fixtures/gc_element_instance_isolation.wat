(module
  (type $inner (array (mut f64)))
  (type $outer (array (mut (ref $inner))))
  (type $roots (array (ref $outer)))
  (table $table 1 (ref null $outer))
  (table $global-table 1 (ref null $inner))
  (global $global-inner (ref $inner)
    (array.new $inner (f64.const nan:0x1) (i32.const 1)))
  (elem (table $table) (i32.const 0) (ref $outer)
    (array.new $outer (array.new $inner (f64.const nan:0x1) (i32.const 1)) (i32.const 2)))
  (elem $passive (ref $outer)
    (array.new $outer (array.new $inner (f64.const nan:0x1) (i32.const 1)) (i32.const 2)))
  (elem (table $global-table) (i32.const 0) (ref $inner) (global.get $global-inner))
