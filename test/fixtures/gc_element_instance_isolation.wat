  (func (export "write-global-element") (param $bits i64)
    (array.set $inner (ref.as_non_null (table.get $global-table (i32.const 0)))
      (i32.const 0) (f64.reinterpret_i64 (local.get $bits))))
  (func (export "read-global") (result i64)
