  (func $passive-value (param $index i32) (result (ref $inner))
    (array.get $outer
      (array.get $roots (array.new_elem $roots $passive (i32.const 0) (i32.const 1)) (i32.const 0))
      (local.get $index)))
  (func (export "read-active") (param $index i32) (result i64)
    (i64.reinterpret_f64 (array.get $inner (call $active (local.get $index)) (i32.const 0))))
  (func (export "read-passive") (param $index i32) (result i64)
    (i64.reinterpret_f64 (array.get $inner (call $passive-value (local.get $index)) (i32.const 0))))
  (func (export "write-active") (param $index i32) (param $bits i64)
    (array.set $inner (call $active (local.get $index)) (i32.const 0) (f64.reinterpret_i64 (local.get $bits))))
  (func (export "write-passive") (param $index i32) (param $bits i64)
