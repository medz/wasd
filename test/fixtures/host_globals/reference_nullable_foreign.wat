;; wasm-tools parse canonicalizes nullable refs. The checked binary expands
;; both parameter/result refs in types 1 and 3 with the valid 0x63 prefix.
(module
  (type $extern_short (func (param externref) (result externref)))
  (type $extern_explicit (func (param (ref null extern)) (result (ref null extern))))
  (type $func_short (func (param funcref) (result funcref)))
  (type $func_explicit (func (param (ref null func)) (result (ref null func))))
  (import "provider" "extern_short" (func $extern_short (type $extern_explicit)))
  (import "provider" "extern_explicit" (func $extern_explicit (type $extern_short)))
  (import "provider" "func_short" (func $func_short (type $func_explicit)))
  (import "provider" "func_explicit" (func $func_explicit (type $func_short)))
  (table 4 funcref)
  (elem (i32.const 0) $extern_short $extern_explicit $func_short $func_explicit)
  (func (export "extern_short_ref") (type $extern_explicit)
    local.get 0 ref.func $extern_short call_ref $extern_explicit)
  (func (export "extern_short_indirect") (type $extern_explicit)
    local.get 0 i32.const 0 call_indirect (type $extern_explicit))
  (func (export "extern_explicit_ref") (type $extern_short)
    local.get 0 ref.func $extern_explicit call_ref $extern_short)
  (func (export "extern_explicit_indirect") (type $extern_short)
    local.get 0 i32.const 1 call_indirect (type $extern_short))
  (func (export "func_short_ref") (type $func_explicit)
    local.get 0 ref.func $func_short call_ref $func_explicit)
  (func (export "func_short_indirect") (type $func_explicit)
    local.get 0 i32.const 2 call_indirect (type $func_explicit))
  (func (export "func_explicit_ref") (type $func_short)
    local.get 0 ref.func $func_explicit call_ref $func_short)
  (func (export "func_explicit_indirect") (type $func_short)
    local.get 0 i32.const 3 call_indirect (type $func_short))
)
