;; Regenerate with pinned wasm-tools 1.254.0.
;; wasm-tools parse test/fixtures/gc_f32_element_bits.wat -o test/fixtures/gc_f32_element_bits.wasm
(module
  (type $a (array (mut f32)))
  (type $refs (array (ref $a)))
  (table $table 9 (ref null $a))
  (elem (table $table) (i32.const 0) (ref $a)
    (array.new $a (f32.const nan:0x1) (i32.const 1))
    (array.new $a (f32.const -nan:0x12345) (i32.const 1))
    (array.new $a (f32.const nan:0x412345) (i32.const 1))
    (array.new $a (f32.const -nan:0x454321) (i32.const 1))
    (array.new $a (f32.const -0x0p+0) (i32.const 1))
    (array.new $a (f32.const 0x1p-149) (i32.const 1))
    (array.new $a (f32.const 0x1.000002p+0) (i32.const 1))
    (array.new $a (f32.const inf) (i32.const 1))
    (array.new $a (f32.const -inf) (i32.const 1))
  )
  (elem $passive (ref $a)
    (array.new_fixed $a 1 (f32.const nan:0x1))
    (array.new_fixed $a 1 (f32.const -nan:0x12345))
    (array.new_fixed $a 1 (f32.const nan:0x412345))
    (array.new_fixed $a 1 (f32.const -nan:0x454321))
    (array.new_fixed $a 1 (f32.const -0x0p+0))
    (array.new_fixed $a 1 (f32.const 0x1p-149))
    (array.new_fixed $a 1 (f32.const 0x1.000002p+0))
    (array.new_fixed $a 1 (f32.const inf))
    (array.new_fixed $a 1 (f32.const -inf))
  )
  (func (export "active-array") (param $index i32) (result i32)
    (i32.reinterpret_f32 (array.get $a
      (ref.as_non_null (table.get $table (local.get $index))) (i32.const 0))))
  (func (export "passive-array") (param $index i32) (result i32)
    (i32.reinterpret_f32 (array.get $a
      (array.get $refs (array.new_elem $refs $passive (local.get $index) (i32.const 1)) (i32.const 0))
      (i32.const 0))))
)
