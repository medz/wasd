;; .toolchains/bin/wasm-tools parse test/fixtures/host_exceptions/reference_provider.wat -o test/fixtures/host_exceptions/reference_provider.wasm
(module
  (type $unary (func (param i32) (result i32)))
  (import "host" "tick" (func $tick))
  (tag $extern (param externref))
  (tag $function (param funcref))
  (tag $mixed (param i32 externref f64))
  (export "extern" (tag $extern))
  (export "extern_alias" (tag $extern))
  (export "function" (tag $function))
  (export "mixed" (tag $mixed))
  (func $increment (export "increment") (type $unary)
    call $tick local.get 0 i32.const 1 i32.add)
  (func (export "wrong") (result f64) f64.const 9)
  (func $hidden_increment (type $unary) local.get 0 call $increment)
  (func $hidden_throw (param externref)
    call $tick local.get 0 throw $extern)
  (elem declare func $increment $hidden_increment $hidden_throw)
  (func (export "throw_extern") (param externref)
    call $tick local.get 0 throw $extern)
  (func (export "throw_function") (param funcref)
    call $tick local.get 0 throw $function)
  (func (export "throw_own_function")
    call $tick ref.func $hidden_increment throw $function)
  (func (export "throw_own_thrower")
    call $tick ref.func $hidden_throw throw $function)
  (func (export "throw_null_function")
    call $tick ref.null func throw $function)
  (func (export "throw_mixed") (param i32 externref f64)
    call $tick local.get 0 local.get 1 local.get 2 throw $mixed)
)
