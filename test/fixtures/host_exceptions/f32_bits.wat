;; .toolchains/bin/wasm-tools parse test/fixtures/host_exceptions/f32_bits.wat -o test/fixtures/host_exceptions/f32_bits.wasm
(module
  (import "host" "tick" (func $tick))
  (import "host" "source" (func $source))
  (import "host" "tag" (tag $tag (param f32)))
  (func (export "throw")
    (local $error exnref)
    (block $caught (result f32 exnref)
      (try_table (catch_ref $tag $caught)
        call $tick i32.const 0x7fc12345 f32.reinterpret_i32 throw $tag)
      unreachable)
    local.set $error drop local.get $error throw_ref)
  (func (export "catch_bits") (result i32)
    (block $caught (result f32)
      (try_table (catch $tag $caught)
        call $tick call $source)
      unreachable)
    i32.reinterpret_f32)
)
